{
  "name": "docker-labs",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": false,
      "version": "latest",
      "dockerDashComposeVersion": "v2",
      "installDockerBuildx": true
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  },
  "forwardPorts": [8080],
  "postCreateCommand": "docker version && docker compose version && docker buildx version",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
